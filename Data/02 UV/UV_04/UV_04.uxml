<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.heaj.samshomework/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Opérations arithmétiques"/>
        <Heaj.Homework.Text text="Nous pouvons évidement utiliser des opérations mathématiques dans nos shaders. Essayez de reproduire ce dégradé en diagonal en piochant dans les nodes suivants :&#10;&#10;• Add&#10;• Subtract&#10;• Multiply&#10;• Divide"/>
        <Heaj.Homework.Callout style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <Heaj.Homework.Text text="Avant d&apos;ouvrir votre shader, je vous invite à regarder attentivement le shader de gauche et vous demander ce qu&apos;il se passe. Essayez de comprendre les valeurs qui se trouve derrière les nuances de gris.&#10;&#10;Par exemple, on peut voir que le dégradé augmente aussi bien en X qu&apos;en Y, on va donc probablement devoir utiliser les deux."/>
        </Heaj.Homework.Callout>
    </Heaj.Homework.ArticleElement>
</ui:UXML>
