<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.heaj.samshomework/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Step"/>
        <Heaj.Homework.Title text="Paramètrons ce noise" type="1"/>
        <Heaj.Homework.Text text="Dans ce shader je vous invite à paramètrer votre propre noise.&#10;Commencez par utiliser le node &quot;Gradient Noise&quot; d&apos;Unity."/>
        <Heaj.Homework.ImageElement source="project://database/Packages/com.heaj.samshomework/Data/03%20Step/Step_05%20-%20Noise/Unity_kyCJikOn43.png?fileID=2800000&amp;guid=800ba851f6335544ab1fb35c623c05ee&amp;type=3#Unity_kyCJikOn43" size="0.5"/>
        <Heaj.Homework.Text text="Comme vous pouvez le constater, celui-ci utilise les Uv avec un scale de 10 par défaut.&#10;Cela veut simplement dire que tant que rien n&apos;est connecté, &#10;"/>
        <Heaj.Homework.ImageElement source="project://database/Packages/com.heaj.samshomework/Data/03%20Step/Step_05%20-%20Noise/Unity_FLflIPWZlY.png?fileID=2800000&amp;guid=2686d19edfc270442ba04d026c80197c&amp;type=3#Unity_FLflIPWZlY" size="0.5"/>
        <Heaj.Homework.Text text="On peut voir dans l&apos;image ci-dessus que le noise est excatement le même."/>
        <Heaj.Homework.Text text="Si on contrôle les Uv, on peut donc faire y ajouter un offset pour faire un panning."/>
    </Heaj.Homework.ArticleElement>
</ui:UXML>
