    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Step"/>
        <Heaj.Homework.Title text="Les autres paramètres" type="1"/>
        <Heaj.Homework.Text text="Nous retrouvons généralement 3 paramètres sur ce genre de noise :"/>
        <Heaj.Homework.Text text="&lt;indent=1em&gt;• La vitesse, qui vient multiplier le temps.&#10;&lt;indent=1em&gt;• La fréquence, qui vient multiplier l&apos;espace.&#10;&lt;indent=1em&gt;• L&apos;amplitude. qui vient multiplier le résultat." style="-unity-text-generator: standard; -unity-paragraph-spacing: 64px;"/>
    </Heaj.Homework.ArticleElement>
