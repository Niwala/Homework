<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.heaj.samshomework/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Step"/>
        <Heaj.Homework.Title text="Retour au Step" type="1"/>
        <Heaj.Homework.Text text="Nous pouvons désormais refaire l&apos;exercice 4 qui avait une ligne verticale."/>
        <Heaj.Homework.Callout icon="project://database/Packages/com.heaj.samshomework/Database/Editor/Icons/alert-triangle-outline-128x128.png?fileID=2800000&amp;guid=027050a9c3393a245a4cae7cb2db7447&amp;type=3#alert-triangle-outline-128x128" color="rgb(190, 139, 72)">
            <Heaj.Homework.Title text="Attention" type="2" style="color: rgb(190, 138, 71); margin-top: 7px;"/>
            <Heaj.Homework.Text text="1. Le noise de base d&apos;Unity sort des valeurs entre 0 et 1.&#10;2. Si je ne veux pas trop casser l&apos;équilibre de mon gradient, j&apos;ai plutôt intérêt d&apos;avoir des valeurs autour de 0.&#10;3. Il faut donc adapter un peu la sortie du noise avant de lui appliquer son amplitude.&#10;" style="-unity-paragraph-spacing: 64px; -unity-text-generator: standard;"/>
        </Heaj.Homework.Callout>
    </Heaj.Homework.ArticleElement>
