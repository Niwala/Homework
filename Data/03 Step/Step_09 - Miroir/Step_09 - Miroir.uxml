<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.heaj.samshomework/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Step"/>
        <Heaj.Homework.Title text="Bonus" type="1"/>
        <Heaj.Homework.Text text="Appliquez un mirroir"/>
        <Heaj.Homework.HintElement text="Indice 1" style="margin-bottom: 6px;">
            <Heaj.Homework.Text text="Comme souvent dans les shader :&#10;Vous devez travailler la source, donc les Uvs, pas le résultat du noise." style="-unity-text-align: middle-center;"/>
        </Heaj.Homework.HintElement>
        <Heaj.Homework.HintElement text="Indice 2">
            <Heaj.Homework.Text text="Rien de fancy, c&apos;est la même opération qui vous permet de faire un miroir sur vos gradients." style="-unity-text-align: middle-center;"/>
        </Heaj.Homework.HintElement>
        <Heaj.Homework.Callout icon="project://database/Packages/com.heaj.samshomework/Database/Editor/Icons/alert-circle-outline-128x128.png?fileID=2800000&amp;guid=cbde7c7ba8dcd2a4b9b804f7a9f0a585&amp;type=3#alert-circle-outline-128x128" color="rgb(159, 207, 255)">
            <Heaj.Homework.Title type="2" text="Plus d&apos;aide ?" style="margin-top: 7px; color: rgb(159, 207, 255);"/>
            <Heaj.Homework.Text text="Si durant cet exercice, vous y percevez la dispute de vos parents, de la mélancolie, des idées noires ou carrément une envie de d&apos;abandonner tout shaders, le service d&apos;aide psycho-social de l&apos;Heaj se tient à votre disposition :"/>
            <Heaj.Homework.Text text="elodie.goffin@heaj.be&#10;0497/36.23.33" selectable="true" focusable="true" style="border-left-color: rgb(159, 207, 255); border-right-color: rgb(159, 207, 255); border-top-color: rgb(159, 207, 255); border-bottom-color: rgb(159, 207, 255); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; color: rgb(159, 207, 255); -unity-text-align: upper-center;"/>
            <Heaj.Homework.Text text="*J&apos;aborde le sujet avec humour mais le contacte est tout à fait réel." style="margin-top: 0; margin-bottom: 4px; opacity: 0.59;"/>
        </Heaj.Homework.Callout>
    </Heaj.Homework.ArticleElement>
</ui:UXML>
