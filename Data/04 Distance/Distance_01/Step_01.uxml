<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.heaj.samshomework/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <Heaj.Homework.ArticleElement>
        <Heaj.Homework.Title text="Step"/>
        <Heaj.Homework.Title text="Properties" type="1"/>
        <Heaj.Homework.Text text="Dans les prochains exercices, vous allez devoir ajouter de nouvelles properties dans votre shader."/>
        <Heaj.Homework.ImageElement source="project://database/Packages/com.heaj.samshomework/Data/03%20Step/Step_01/Photos_ORM78CaD55.png?fileID=2800000&amp;guid=72964cfaac0fda04184a8c5fb240d4f0&amp;type=3#Photos_ORM78CaD55" size="7" style="max-height: 150px;"/>
        <Heaj.Homework.Text text="&#10;Afin d&apos;avoi un rendu similaire à l&apos;exemple, vous devez nommer correctement vos properties pour quelles correspondent aux noms de celles de la solution."/>
        <Heaj.Homework.Title text="Concrètement" type="1"/>
        <Heaj.Homework.Text text="Dans le shader ci-contre, vous devez créer une nouvelle propriété :&#10;&lt;indent=1em&gt;• De type &quot;float&quot;&#10;&lt;indent=1em&gt;• Nommé &quot;Threshold&quot;&#10;Vous pouvez ensuite utiliser cette propriété dans votre graph à l&apos;aide d&apos;un simple drag-drop." style="-unity-text-generator: standard;"/>
        <Heaj.Homework.Text text="Si cela est correctement setup, votre paramètre sera lié automatiquement au slider situé au-dessus de l&apos;exercice." style="-unity-text-generator: standard;"/>
    </Heaj.Homework.ArticleElement>
</ui:UXML>
