#pragma kernel CSMain
#pragma target 5.0

Texture2D<float4> _TexA;
Texture2D<float4> _TexB;
RWStructuredBuffer<uint> _Error;

[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    float4 a = _TexA[id.xy];
    float4 b = _TexB[id.xy];
    
    float3 dif = abs(a - b);
    uint error = (uint) ((dif.x + dif.y + dif.z) * 10);
    
    InterlockedAdd(_Error[0], error);
}
