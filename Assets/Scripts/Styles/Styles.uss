.homework-outliner {
    background-color: var(--unity-colors-default-background);
    min-width: 200px;
    border-top-color: var(--unity-colors-window-border);
    border-top-width: 1px;
}

.homework-outliner-item {
    flex-direction: row;
}

.homework-outliner-item-label {
    margin-top: 2px;
    border-top-width: 2px;
    flex-grow: 1;
    flex-shrink: 1;
}

.homework-outliner-item-label:checked {
    color: rgb(144, 177, 233);
    -unity-font-style: bold;
}

.homework-outliner-item-icon {
    width: 16px;
    height: 16px;
    align-self: flex-end;
    flex-shrink: 0;
    flex-grow: 0;
    opacity: 0.5;
    margin-right: 3px;
}

.homework-outliner-item-icon:hover {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: var(--unity-colors-button-background);
}

.homework-content {
    border-top-color: var(--unity-colors-window-border);
    border-top-width: 1px;
}

.homework-article {
    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    flex-shrink: 0;
    min-width: 300px;
}

.homework-title-0 {
    font-size: 28px;
    color: rgb(85, 131, 195);
    flex-shrink: 0;
    margin-top: 20px;
}

.homework-title-1 {
    font-size: 24px;
    color: rgb(183, 183, 183);
    flex-shrink: 0;
    margin-top: 20px;
}

.homework-title-2 {
    font-size: 18px;
    color: rgb(85, 130, 193);
    flex-shrink: 0;
    margin-top: 20px;
    -unity-font-style: bold;
}

.homework-callout {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    min-height: 20px;
    flex-shrink: 0;
    background-color: var(--unity-colors-input_field-background);
    margin-top: 10px;
    margin-bottom: 10px;
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
    flex-direction: row;
}

.homework-callout-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    flex-grow: 0;
    margin-right: 7px;
    margin-top: 5px;
    margin-bottom: 3px;
}

.homework-text {
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 10px;
}

.homework-article-area {
    min-width: 300px;
}

.homework-shader-area {
    min-width: 150px;
}

.homework-chapter-fields {
    flex-grow: 1;
    min-width: 200px;
    flex-shrink: 1;
}

.homework-chapter-controls {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-end;
    min-width: 60px;
    justify-content: flex-end;
}

.homework-chapter-controls-btn {
    height: 24px;
}

.homework-image {
    align-self: flex-start;
    aspect-ratio: 0.5;
    flex-shrink: 1;
}

.homework-comment-overlay {
    opacity: 0;
    top: 0;
    position: absolute;
    left: 0;
    width: 10px;
    height: 10px;
    background-color: rgba(154, 46, 46, 0.31);
    flex-shrink: 0;
    flex-grow: 0;
}

.homework-comment-overlay:active {
    border-left-color: rgb(0, 138, 255);
    border-right-color: rgb(0, 138, 255);
    border-top-color: rgb(0, 138, 255);
    border-bottom-color: rgb(0, 138, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: rgba(0, 138, 255, 0.25);
    opacity: 1;
}

.homework-comment-popup {
    background-color: var(--unity-colors-app_toolbar-background);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    position: absolute;
    left: 5px;
    bottom: 5px;
    right: 5px;
    min-height: 120px;
    display: none;
}

.homework-comment-anchor {
    position: absolute;
    top: 50%;
    right: -24px;
    width: 24px;
    height: 24px;
    background-color: var(--unity-colors-input_field-background);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 5px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    opacity: 0.7;
}

.homework-comment-anchor:hover {
    background-color: var(--unity-colors-button-background-hover_pressed);
    opacity: 1;
}

.homework-outliner-tree-view {
    background-color: var(--unity-colors-input_field-background);
}

.homework-warmup-counter {
    padding-top: 5px;
    padding-right: 20px;
    padding-bottom: 5px;
    padding-left: 20px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: var(--unity-colors-input_field-background);
    align-items: center;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-color: var(--unity-colors-app_toolbar_button-border);
    border-right-color: var(--unity-colors-app_toolbar_button-border);
    border-bottom-color: var(--unity-colors-app_toolbar_button-border);
    border-left-color: var(--unity-colors-app_toolbar_button-border);
    margin-top: 10px;
    margin-bottom: 10px;
    min-width: 500px;
}

.homework-warmup-counter-label {
    font-size: 98px;
    opacity: 0.34;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Roboto-Bold.ttf?fileID=12800000&guid=c22bd1c85c786b947b1d8e91396467be&type=3#Roboto-Bold");
    letter-spacing: 4px;
    aspect-ratio: 5;
    -unity-text-align: upper-center;
    -unity-font-style: normal;
}

.homework-warmup-counter-label:checked {
    opacity: 1;
}

.homework-warmup-counter-btn {
    height: 40px;
    width: 150px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    font-size: 32px;
}

.homework-warmup-counter-btn:hover {
    background-color: rgb(202, 118, 77);
}

.homework-warmup-counter-btn:active {
    background-color: rgb(113, 59, 33);
}

.homework-warmup-shader-area {
    background-color: rgb(24, 24, 24);
    height: 10px;
    width: 100%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-bottom: 20px;
    transition-property: height;
    transition-duration: 1s;
    transition-timing-function: ease-out-circ;
    background-size: 100% 10%;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    overflow: hidden;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.homework-warmup-shader-area:checked {
    transition-duration: 0.5s;
    transition-timing-function: ease-out-elastic;
    transition-property: height;
    height: 300px;
}

.homework-callout-end-button {
    position: relative;
    height: 20px;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 5px;
    margin-right: 3px;
    margin-bottom: 5px;
    margin-left: 0;
    align-self: flex-end;
}

.homework-graph-view {
    aspect-ratio: 1;
    border-top-color: var(--unity-colors-object_field-border);
    border-right-color: var(--unity-colors-object_field-border);
    border-bottom-color: var(--unity-colors-object_field-border);
    border-left-color: var(--unity-colors-object_field-border);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.homework-graph-bar {
    position: absolute;
    background-color: var(--unity-colors-default-background);
    border-top-color: var(--unity-colors-object_field-border);
    border-right-color: var(--unity-colors-object_field-border);
    border-bottom-color: var(--unity-colors-object_field-border);
    border-left-color: var(--unity-colors-object_field-border);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    flex-direction: row;
    justify-content: space-between;
}

.homework-graph-bar-label {
    -unity-text-align: middle-center;
    opacity: 0.8;
}

.homework-graph-element {
    flex-grow: 1;
    flex-shrink: 1;
    height: 600px;
    flex-direction: row;
    margin-bottom: 10px;
    margin-top: 10px;
}

.homework-graph-description {
    flex-grow: 1;
    min-width: 200px;
}

.homework-graph-canvas {
    flex-grow: 1;
    overflow: hidden;
}

.homework-graph-frame {
    margin-left: 20px;
}

.homework-hint-mask {
    background-color: var(--unity-colors-input_field-background);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    opacity: 1;
}

.homework-hint-mask:hover {
    background-color: var(--unity-colors-button-background);
}

.homework-hint-mask:checked {
    background-color: var(--unity-colors-button-background-pressed);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1s;
    transition-timing-function: ease-in-out;
}

.homework-hint-label {
    -unity-text-align: middle-center;
    font-size: 16px;
    flex-grow: 1;
}

.homework-hint {
    border-top-color: var(--unity-colors-input_field-border);
    border-right-color: var(--unity-colors-input_field-border);
    border-bottom-color: var(--unity-colors-input_field-border);
    border-left-color: var(--unity-colors-input_field-border);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 5px;
    padding-right: 10px;
    padding-bottom: 5px;
    padding-left: 10px;
    background-color: rgba(0, 0, 0, 0.12);
}

.homework-shader-exercice {
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    flex-direction: row;
    flex-grow: 1;
}

.homework-shader-container {
    align-items: flex-start;
    flex-grow: 1;
    margin-right: 5px;
    margin-left: 5px;
    margin-bottom: 44px;
}



.homework-shader-frame {
    background-color: var(--unity-colors-input_field-background);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    flex-grow: 1;
    aspect-ratio: 1;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.homework-shader-element {
    flex-shrink: 1;
    flex-grow: 1;
    background-color: rgb(22, 22, 22);
    aspect-ratio: 1;
    min-width: 64px;
    min-height: 64px;
}

.homework-shader-controls-container {
    flex-grow: 1;
    top: 5px;
    left: 0;
    right: 0;
    align-items: center;
}

.homework-shader-controls {
    flex-direction: row;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-color: var(--unity-colors-input_field-border_accent);
    border-right-color: var(--unity-colors-input_field-border_accent);
    border-bottom-color: var(--unity-colors-input_field-border_accent);
    border-left-color: var(--unity-colors-input_field-border_accent);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    background-color: var(--unity-colors-default-background);
    position: absolute;
    top: 0;
}

.homework-shader-btn {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    padding-bottom: 7px;
    padding-top: 7px;
    padding-right: 7px;
    padding-left: 7px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.homework-shader-btn-icon {
    width: 16px;
    height: 16px;
    flex-grow: 0;
    flex-shrink: 0;
}
