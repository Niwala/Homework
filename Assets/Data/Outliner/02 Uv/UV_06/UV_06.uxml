<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Scripts/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <SamsBackpack.Homework.ArticleElement>
        <SamsBackpack.Homework.Title text="Les vecteurs"/>
        <SamsBackpack.Homework.Title text="Vector" type="1"/>
        <SamsBackpack.Homework.Text text="Lorsque nous travaillons avec des Uv, nous travaillons avec un vecteur.&#10;Dans notre cas, cela veut tout simplement dire que nous paquons plusieurs nombres ensembles.&#10;&#10;Si vous regardez la sortie de notre node, vous y voyez un &lt;color=#d1a9cb&gt;port rose avec un (4)&lt;/color&gt; à côté du nom. Cela indique que ce lien déplace 4 nombres d&apos;un coup. Il sont nommés (XYZW) ou (RGBA) en fonction de la situation. "/>
        <SamsBackpack.Homework.ImageElement source="project://database/Assets/Data/Outliner/02_Uv/UV_02/Photos_b2UfVG8o6U.png?fileID=2800000&amp;guid=1cf707d8880124b4a88139a76bdb3261&amp;type=3#Photos_b2UfVG8o6U" size="0.7"/>
        <SamsBackpack.Homework.Text text="Même si dans la grande majorité des cas seul le XY nous intéresse en UV, Unity est capable d&apos;encoder des Uv sous forme de Vector4. "/>
        <SamsBackpack.Homework.Title text="Conversion" type="1"/>
        <SamsBackpack.Homework.Text text="Lorsque nous connectons des vecteurs d&apos;un node à l&apos;autre, le graph s&apos;occupe lui-même de faire la conversion. Cela est d&apos;ailleurs visible dans le premier exercice qui ne garde que le (XYZ) car tout ce que veux la BaseColor c&apos;est 3 nombres pour former une couleur RGB."/>
        <SamsBackpack.Homework.ImageElement source="project://database/Assets/Data/Outliner/02_Uv/UV_02/Photos_Y3tcEm9oUD.png?fileID=2800000&amp;guid=e03afd7ca5cd34646be1fea41e151c89&amp;type=3#Photos_Y3tcEm9oUD" size="0.7"/>
        <SamsBackpack.Homework.Callout style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <SamsBackpack.Homework.Text text="Remarquez que si vous convertissez de cette manière un &lt;color=#77d3d5&gt;nombre seul (1)&lt;/color&gt; vers n&apos;import quel vecteur il sera automatiquement placé dans chaque élément de ce vecteur.&#10;&#10;Donc le nombre &lt;color=#77d3d5&gt;0.3&lt;/color&gt; converti en Vecteur4 va donner &lt;color=#ffcdf7&gt;(0.3, 0.3, 0.3, 0.3)&lt;/color&gt; par exemple."/>
        </SamsBackpack.Homework.Callout>
        <SamsBackpack.Homework.Title text="Split, Combine, Append &amp; Swizzle" type="1"/>
        <SamsBackpack.Homework.Text text="Il est très facile de restructurer ces vecteurs comme on l&apos;entend. Plusieurs nodes permettent ce travail avec différentes approches.&#10;&#10;Notez que cela ne change rien à la manière dont le shader est compilé, il n&apos;y a donc pas une approche qui serait plus performante qu&apos;une autre."/>
        <ui:ScrollView mode="VerticalAndHorizontal">
            <SamsBackpack.Homework.ImageElement source="project://database/Assets/Data/Outliner/02_Uv/UV_02/Unity_bXnHW9Jr1l.png?fileID=2800000&amp;guid=5d6c96ec40866684ea91763be709e09e&amp;type=3#Unity_bXnHW9Jr1l" size="0.7"/>
        </ui:ScrollView>
    </SamsBackpack.Homework.ArticleElement>
</ui:UXML>
