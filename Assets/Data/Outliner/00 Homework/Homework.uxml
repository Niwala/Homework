<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Scripts/Styles/Styles.uss?fileID=7433441132597879392&amp;guid=6528a26abad5e92429833d3a7cb12172&amp;type=3#Styles"/>
    <SamsBackpack.Homework.ArticleElement>
        <SamsBackpack.Homework.Title text="Projet Homework"/>
        <SamsBackpack.Homework.Title text="Introduction" type="1"/>
        <SamsBackpack.Homework.Text text="Vous retrouverez ici une série d&apos;exercices à réaliser chez vous.&#10;&#10;Les exercices seront débloqués au fur et à mesure de l&apos;année. Je vous en ferai à chaque fois la communication en classe ou via Teams. C&apos;est pourquoi si vous venez à rater un cours ou une partie, vous devez prendre la responsabilité de vérifier par vous-même si il n&apos;y a pas de nouveaux exercices disponibles à réaliser."/>
        <SamsBackpack.Homework.Title text="Fonctionnement" type="1"/>
        <SamsBackpack.Homework.Text text="• Les exercices disponibles apparaitront dans la liste de chapitres sur votre gauche.&#10;• Lorsque vous avez terminé un chapitre, vous pouvez en faire un export.&#10;• Les exports sont des fichiers à remettre sur Teams, cela me permet de suivre votre progression.&#10;• Un export contient de quoi vous identifier et l&apos;état des exercices dans un chapitre.&#10;• Si vous avez un souci technique sur ce projet il est de votre responsabilité de &lt;a href=&quot;https://teams.microsoft.com/l/chat/0/0?users=samuel.jemine@heaj.be&quot;&gt;me contacter via Teams&lt;/a&gt;."/>
    </SamsBackpack.Homework.ArticleElement>
</ui:UXML>
